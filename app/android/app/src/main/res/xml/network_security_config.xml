<?xml version="1.0" encoding="utf-8"?>
<!--
  Message payloads are end-to-end encrypted regardless of transport, so
  cleartext ws:// only ever exposes routing metadata (never content) to an
  on-path observer. That metadata is the thing the rest of this design spends
  its effort on, so the permission below is not the whole answer and was never
  meant to be.

  Cleartext stays permitted here because a LAN or emulator address cannot be
  expressed as a domain-config exception and local testing has to work out of
  the box. What decides whether a cleartext address is DIALLED is the client:
  `core/relay_url.dart` refuses a public ws:// relay unless the user was asked
  and said yes, and refuses one from a restored backup outright. Local and
  private addresses connect without a word.

  Until 2026-09-13 the client's half of that was a notice beside a "Test"
  button, so this file was carrying the whole policy on its own. For
  production, deploy the relay behind TLS (Render/Fly give you a free wss://
  URL automatically).
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
