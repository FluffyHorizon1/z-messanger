  "chatFailedStorage": "El almacenamiento de este dispositivo no pudo guardar eso. Si sigue pasando, comprueba que el dispositivo tiene espacio libre.",
  "@chatFailedStorage": {"description": "Shown in a chat or on the new-group screen when this device's own storage refused to save what the person did — a message sent, a message forwarded, a reaction, a group made (a full disk, a locked or closed database). Not a problem with the network or the other person; load-bearing clause: it points at the device's storage. No detail of the failure is shown."},
  "chatFileTooLarge": "Eso pasa de {limit}, lo máximo que puede llevar un mensaje, así que no se envió nada.",
  "@chatFileTooLarge": {"description": "Shown in a chat when a file or a voice message is over the most one message can carry, and nothing was sent. {limit} is that size, written as the app writes sizes (for example \"24.0 MB\").", "placeholders": {"limit": {"type": "String"}}},
  "chatSendFailedOther": "No se pudo enviar el mensaje. Vuelve a intentarlo.",
  "@chatSendFailedOther": {"description": "Shown in a chat when a message — text, a voice message or a file — could not be sent, for a reason the app does not name. No detail of the failure is shown; the person can send it again."},
  "chatForwardFailedOther": "No se pudo reenviar el mensaje. Vuelve a intentarlo.",
  "@chatForwardFailedOther": {"description": "Shown in a chat when forwarding a message to another conversation failed, for a reason the app does not name. No detail of the failure is shown; the person can try again."},
  "chatReactionFailedOther": "No se pudo cambiar la reacción. Vuelve a intentarlo.",
  "@chatReactionFailedOther": {"description": "Shown in a chat when adding, changing or withdrawing a reaction to a message failed, for a reason the app does not name. No detail of the failure is shown; the person can try again."},
  "chatAttachNoAccess": "Z no tiene permiso para usar la cámara o tus fotos. Permítelo en los ajustes de este dispositivo y vuelve a intentarlo.",
  "@chatAttachNoAccess": {"description": "Shown in a chat when the camera or the photo library refused Z because the person has not allowed Z to use it. Load-bearing clause: it says where to allow it — this device's own settings, not Z's."},
  "chatAttachFailed": "No se pudo abrir la cámara ni la galería. Vuelve a intentarlo.",
  "@chatAttachFailed": {"description": "Shown in a chat when taking a photo, or choosing a photo or a video from the library, failed for a reason the app does not name. No detail of the failure is shown; the person can try again."},
  "chatSaveFailedOther": "No se pudo guardar el archivo. Vuelve a intentarlo.",
  "@chatSaveFailedOther": {"description": "Shown in a chat when saving the decrypted copy of a file or a voice message failed. No detail of the failure is shown; the person can try again."},
  "grpCreateFailedOther": "No se pudo crear el grupo. Vuelve a intentarlo.",
  "@grpCreateFailedOther": {"description": "Shown on the new-group screen when the group could not be made, for a reason the app does not name. No detail of the failure is shown; the person can try again."},
  "connectNotSaved": "Este dispositivo no pudo guardar eso, así que nada ha cambiado. Vuelve a intentarlo; si sigue pasando, comprueba que el dispositivo tiene espacio libre.",
  "@connectNotSaved": {"description": "Shown on the CONNECT tab when discarding a pending invite, or stopping the wait for someone who answered a group invite link, could not be saved because this device's own storage refused the write (a full disk, a locked or closed database). Nothing was discarded or stopped: the invite, or the wait, is as it was, and the person can press again; load-bearing clause: nothing has changed. No detail of the failure is shown."},
  "connectFailedRefused": "Se contactó con el relay, pero rechazó este paso; se seguirá intentando.",
  "@connectFailedRefused": {"description": "Shown under a pending invite when the last attempt to carry it forward reached the relay and the relay refused it — the other side's mailbox there full, too many attempts at once, the relay's storage full. Not a relay that could not be reached, which has a line of its own. The invite is kept and retried on its own; load-bearing clause: it says the app will keep trying, so the person does not discard a working invite. No detail of the failure is shown."},
  "linkCodeLinked": "Ese código ya vinculó un dispositivo a tu cuenta. Para vincular otro dispositivo, elige «Vincular a una cuenta existente» en él para obtener un código nuevo, e introdúcelo aquí.",
  "backupSaveDialogTitle": "Guarda tu copia de seguridad de Z",
  "backupAutoNotOn": "Este dispositivo no pudo guardar el código, así que las copias automáticas siguen desactivadas. Comprueba que tiene espacio libre y vuelve a intentarlo.",
  "backupAutoNotOff": "Este dispositivo no pudo cambiar el ajuste, así que las copias automáticas siguen activadas. Vuelve a intentarlo.",
  "chatPickFailed": "No se pudo abrir el explorador de archivos. Vuelve a intentarlo.",
  "@chatPickFailed": {"description": "Shown in a chat when the file browser, opened to choose a file to send, failed for a reason the app does not name. Nothing was sent; no detail of the failure is shown, and the person can try again."},
  "chatPickReadFailed": "No se pudo leer el archivo que elegiste, así que no se envió nada. Vuelve a intentarlo.",
  "@chatPickReadFailed": {"description": "Shown in a chat when a file was chosen in the file browser but the copy it handed over could not be read. Nothing was sent; no detail of the failure is shown, and the person can try again."},
  "chatFileReceiving": "Recibiendo {got} de {total}…",
  "@chatFileReceiving": {"description": "Under the name of a file in a chat while it is still arriving: how many of its parts have come so far, and how many it has. {got} and {total} are those two numbers. Replaced by the file's size once every part has come.", "placeholders": {"got": {"type": "int"}, "total": {"type": "int"}}}
