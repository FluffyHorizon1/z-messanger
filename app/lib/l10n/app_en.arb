  "ciResetSession": "Reset secure session",
  "@ciResetSession": {
    "description": "Row label for the session reset."
  },
  "ciResetSessionHelp": "Start a fresh encryption session (use if messages stop decrypting)",
  "@ciResetSessionHelp": {
    "description": "When to use the reset. The parenthesis is the only guidance a user has for a control they should almost never touch."
  },
  "ciResetSessionDone": "Secure session reset",
  "@ciResetSessionDone": {
