# Node
node_modules/
npm-debug.log*

# The transparency log's entries and a mirror's copy (kt/server.js, kt/tools/mirror.js)
kt/data/
kt/mirror/

# Dart / Flutter
.dart_tool/
.packages
build/
.flutter-plugins
.flutter-plugins-dependencies
app/.flutter-plugins*
**/doc/api/
.pub-cache/
.pub/
# Lockfiles: an application's is committed, a library's is not. app/'s is
# tracked. protocol/'s is deliberately untracked — CI resolves it afresh, so
# its versions are pinned in protocol/pubspec.yaml — and so it is ignored too.
# (This used to be one line with the comment after the pattern; gitignore has
# no trailing comments, so that line matched nothing at all.)
pubspec.lock
!app/pubspec.lock

# IDE
.idea/
.vscode/
*.iml

# OS
.DS_Store
Thumbs.db

# Local build/test scratch
/tmp/
*.log

# Android local config
app/android/local.properties
app/android/key.properties
*.keystore
*.jks

# Secrets / user data (should never exist in-repo, but just in case)
*.zid

# Python bytecode from the vector verifiers (protocol/tool/verify_*.py)
__pycache__/
*.pyc
