{
  "suite": "intro_link",
  "version": 1,
  "description": "Public introduction links (PROTOCOL 21.9, ADR 0032): a handle's introduction mailbox handed out directly as a zi1. code, with no registry between. Links from introduction seeds at pow 16, 20 and 28 with every intermediate (the keys exactly as 21.3 derives a handle's, the body, the check, the code and the link at the default host); inputs a reader takes (a bare code, the link, a host beginning i, a query, whitespace, no scheme); inputs it refuses with the reason it names (a contact code, both invite versions, a handle, a newer version, padding, the standard alphabet, wrong lengths, case, a damaged check, pow 15 and 29, and every weak intro and xintro); and a request through the pow-16 link: sealed to its xintro, stamped at its pow and at a raised bits, and the acknowledgement verified under its intro.",
  "format": {
    "prefix": "zi1.",
    "check_context": "z-intro-link-v1:",
    "body": "u8(pow) || intro(32) || xintro(32)",
    "body_bytes": 65,
    "check": "SHA-256(utf8(check_context) || body)[0..4]",
    "check_bytes": 4,
    "code": "prefix || b64url(body || check)",
    "encoded_chars": 92,
    "code_chars": 96,
    "link": "\"https://\" || host || \"/c#\" || code",
    "path": "/c",
    "default_host": "www.zmessengers.com",
    "default_pow": 20,
    "pow_min": 16,
    "pow_max": 28,
    "x_hkdf_salt": "z-handle-intro-x-v1",
    "reading": "trim ASCII whitespace (U+0009-U+000D, U+0020); given a #, read only what follows the first one; then, in order: the prefix zi1. (zi, another version without a leading zero, and . is newerVersion; anything else notALink), only base64url characters (notBase64url), exactly 92 of them (wrongLength), the check (badCheck), pow 16-28 (powOutOfRange), intro a strong Ed25519 key (weakIntro), xintro a strong X25519 key (weakXintro)",
    "problems": [
      "notALink",
      "newerVersion",
      "notBase64url",
      "wrongLength",
      "badCheck",
      "powOutOfRange",
      "weakIntro",
      "weakXintro"
    ]
  },
